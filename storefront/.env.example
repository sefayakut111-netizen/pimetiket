# Pim Etiket — Storefront environment example
# Kopyala: cp .env.example .env.local

# Public site URL — sitemap, canonical, OG/twitter:url, JSON-LD için.
# Production: https://pimetiket.com
# Local dev: http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ============================================================
# Supabase — Auth + DB + Storage (Faz 1)
# ============================================================
# 1. https://supabase.com/dashboard adresine git → New Project
# 2. Region: Frankfurt (eu-central-1) önerilir (TR'ye yakın)
# 3. Project Settings → API → URL ve anon/public key kopyala
# 4. SQL Editor → supabase/migrations/001_initial_schema.sql çalıştır
# 5. Authentication → URL Configuration → Site URL + Redirect URLs
#    Site URL: http://localhost:3001
#    Redirect URLs: http://localhost:3001/auth/callback, https://pimetiket.com/auth/callback
# 6. (Opsiyonel) Auth → Providers → Google enable + GCP client_id/secret
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — sadece server-side admin işlemleri için.
# UI'a koyma. Edge function / Route handler'da env-only kullanılır.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# Pim AI agent (GPT-4o) — Tasarımcı Pim quote tool için
# ============================================================
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ============================================================
# (Faz 2) Ödeme — ParamPOS
# ============================================================
# PARAM_MERCHANT_ID=
# PARAM_API_KEY=
# PARAM_SECRET_KEY=
# PARAM_GUID=
# PARAM_CALLBACK_IP_ALLOWLIST=

# ============================================================
# (Faz 4) Hata + analytics
# ============================================================
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
