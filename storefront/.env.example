# Pim Etiket — Storefront environment example
# Kopyala: cp .env.example .env.local

# Public site URL — sitemap, canonical, OG/twitter:url, JSON-LD için.
# Production: https://pimetiket.com
# Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# Supabase — Auth + DB + Storage (P0)
# ============================================================
# Setup adımları için bkz: supabase/README.md
#
# Hızlı özet:
# 1. https://supabase.com/dashboard → New Project (Region: Frankfurt)
# 2. Project Settings → API → URL + anon/public key + service_role key
# 3. SQL Editor → supabase/migrations/001..006 sırayla çalıştır
# 4. Storage → 3 bucket aç (designs, return-photos, public-assets)
# 5. Authentication → URL Configuration → Site URL + Redirect URLs
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SADECE server-side (Route handler / Server Action / Edge fn).
# RLS bypass eder; refund + status update + coupon CRUD + admin işlemleri için.
# ASLA NEXT_PUBLIC_ prefix'i ile başlatma — client'a sızar.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# Pim AI agent (GPT-4o) — Tasarımcı Pim quote tool için
# ============================================================
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ============================================================
# (P0-3) Ödeme — PayTR iFrame API
# ============================================================
# Setup:
# 1. https://www.paytr.com/magaza/basvuru-formu → mağaza başvurusu
# 2. Hesap onaylanınca: https://www.paytr.com/magaza/yonetim
#    → Mağaza Bilgileri → Mağaza ID + Mağaza Anahtarı + Mağaza Salt
# 3. API & Çoklu Mağaza → Bildirim URL (callback) ekle:
#    https://pimetiket.com/api/payment/callback
# 4. IP whitelist (opsiyonel): Vercel/Cloudflare IP'lerini ekle
# 5. Test kartlar: https://dev.paytr.com/test-kartlari
#    Test kart no: 4355 0843 5508 4358 (3D başarılı)
#
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
#
# Test mode: 1 = sandbox (gerçek tahsilat YOK), 0 = production
# ⚠️ Production'a alırken explicit "0" set et — default 1 (güvenli)
PAYTR_TEST_MODE=1

# ============================================================
# (P0) Email — Resend (üretim kritik — sipariş onay/prova/kargo mailleri)
# ============================================================
# Setup rehberi: docs/RESEND-SETUP.md (5 adım, 30 dk, 0₺/ay)
# 1. https://resend.com → kayıt + domain ekle (pimetiket.com)
# 2. DNS doğrula (SPF/DKIM/DMARC — Cloudflare TXT/CNAME)
# 3. API Keys → "Pim Etiket Production" → re_xxxxx kopyala
# 4. Vercel Settings → Environment Variables → aşağıdaki 2 değişken
# 5. Redeploy → ~2 dk sonra mailler aktif
#
# ⚠️ Bu env'ler set değilse: mail_outbox'a kayıt yazılır ama gönderim
# YAPILMAZ. Müşteri sipariş onay maili almaz!
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Pim Etiket <info@pimetiket.com>

# ============================================================
# (P2) SMS — Netgsm (opsiyonel — mail zaten yeterli)
# ============================================================
# Sefa kararı: mail bildirimleri (Resend) varsa SMS gerekli değil.
# İleride büyük müşteri segmenti telefon tercih ederse aktif edilir.
#
# Kullanılan yerler (env aktifse otomatik tetiklenir):
#   - lib/sms/netgsm.ts (üst seviye API)
#   - Kargoya verildi bildirimi (opsiyonel, mail varsa skip)
#
# Aktivasyon:
#   1. https://www.netgsm.com.tr → mağaza panel → Müşteri Kodu
#   2. API kullanıcı şifresi ayrı (panel girişinden FARKLI)
#   3. Header (gönderici adı) — 11 karakter limit, izinli ad
#   4. Aşağıdaki 3 env'i Vercel'e ekle + Redeploy
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=PIMETIKET

# ============================================================
# (P1) Hata takibi + analytics
# ============================================================
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ============================================================
# (Sefa 18 May v68) Cloudflare R2 Cold Storage
# ============================================================
# 90+ gün hareketsiz müşteri verisini Supabase → R2 transfer
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=pim-etiket-archive
# R2_ENDPOINT=https://<account_id>.eu.r2.cloudflarestorage.com
# R2_ARCHIVE_DRY_RUN=true

# ============================================================
# (P0) Yurtiçi Kargo SOAP API (üretim kritik — otomatik etiket + tracking)
# ============================================================
# Setup rehberi: docs/YURTICI-KARGO-SETUP.md (4 adım, 30 dk)
#
# Anlaşma → Yurtiçi sana USERNAME/PASSWORD verir, env'lere yaz.
# Env yokken bot DRY_RUN modunda sahte event üretir (manuel tracking
# girişi fallback olarak çalışır).
#
# ⚠️ Env'ler set değilse: kargo etiketi PDF basılır ama Yurtiçi sistemine
# otomatik gönderim talimatı atılmaz + tracking event sahtedir.
YURTICI_USERNAME=
YURTICI_PASSWORD=
YURTICI_LANGUAGE=TR
YURTICI_TRACKING_ENDPOINT=http://webservices.yurticikargo.com:8080/KOPSWebServices/ShippingOrderDispatcherServices
YURTICI_DRY_RUN=true

# Cron secret — tüm cron endpoint'leri için Bearer auth
# CRON_SECRET=
