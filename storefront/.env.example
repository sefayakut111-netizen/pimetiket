# Pim Etiket — Storefront environment example
# Kopyala: cp .env.example .env.local

# ============================================================
# Site (P0)
# ============================================================
# Canonical URL — sitemap, OG, PayTR callback, magic link redirect.
# Production: https://pimetiket.com | Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# Supabase — Auth + DB + Storage (P0)
# ============================================================
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role — SADECE server-side. RLS bypass. ASLA NEXT_PUBLIC_ ile başlatma.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# Ödeme — PayTR iFrame API (P0)
# ============================================================
# Mağaza paneli → Mağaza ID + Key + Salt
# Bildirim URL: https://pimetiket.com/api/payment/callback
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 = sandbox, 0 = production tahsilat
PAYTR_TEST_MODE=1

# ============================================================
# OpenAI — AI tasarım QC + Pim sohbet (P0)
# ============================================================
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ============================================================
# E-posta — Resend (P0)
# ============================================================
# Setup: docs/RESEND-SETUP.md
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Pim Etiket <info@pimetiket.com>
# Alternatif gönderen (RESEND_FROM_EMAIL yoksa kullanılır)
MAIL_FROM_ADDRESS=

# Webhook: https://pimetiket.com/api/webhooks/resend
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Lead mail unsubscribe HMAC — boşsa CRON_SECRET fallback
UNSUBSCRIBE_SECRET=

# Yeni sipariş admin bildirimi (virgülle çoklu)
ADMIN_NOTIFICATION_EMAIL=sefa@pimetiket.com

# ============================================================
# Cron — Vercel scheduled jobs (P0)
# ============================================================
# Tüm /api/cron/* endpoint'leri Bearer auth ile korunur.
# openssl rand -hex 32
CRON_SECRET=

# ============================================================
# Kargo — Yurtiçi SOAP (P1)
# ============================================================
# Setup: docs/YURTICI-KARGO-SETUP.md
YURTICI_USERNAME=
YURTICI_PASSWORD=
YURTICI_LANGUAGE=TR
YURTICI_TRACKING_ENDPOINT=http://webservices.yurticikargo.com:8080/KOPSWebServices/ShippingOrderDispatcherServices
YURTICI_DRY_RUN=true

# Kargo etiketi gönderici bilgileri (opsiyonel override)
SHIPPING_SENDER_NAME=Pim Etiket
SHIPPING_SENDER_ADDRESS=
SHIPPING_SENDER_CITY=Üsküdar / İstanbul
SHIPPING_SENDER_PHONE=0 850 000 00 00

# ============================================================
# SMS — Netgsm (P2, opsiyonel)
# ============================================================
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=PIMETIKET

# ============================================================
# Cloudflare R2 — cold archive (P2)
# ============================================================
# Setup: docs/R2-PRODUCTION.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pim-etiket-archive
R2_ENDPOINT=https://<account_id>.eu.r2.cloudflarestorage.com
R2_ARCHIVE_DRY_RUN=true

# ============================================================
# AI — arka plan silme (P2, opsiyonel)
# ============================================================
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ============================================================
# Admin güvenlik (P1)
# ============================================================
# true = admin panelde 2FA zorunlu
ADMIN_2FA_REQUIRED=false

# ============================================================
# Auditor cron digest (P2)
# ============================================================
AUDITOR_NOTIFY_EMAILS=

# ============================================================
# Analytics + hata takibi (P2)
# ============================================================
# Sentry — client DSN (browser hata + replay)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.de.sentry.io/xxx
# Build-time source map upload (Vercel Production env)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ============================================================
# Geliştirme / opsiyonel
# ============================================================
# Admin panelde fiyat simülatörü menüsü
NEXT_PUBLIC_ALLOW_SIMULATOR=false

# Dev-only API (/api/dev/mock-checkout) — production'da her zaman kapalı
ENABLE_DEV_ENDPOINTS=false

# Lead magnet şablon indirme URL'i
NEXT_PUBLIC_TEMPLATE_DOWNLOAD_URL=

# Vercel otomatik set eder — manuel set etmeyin
# VERCEL_URL=
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=
